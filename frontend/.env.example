# --- SERVER ONLY (never prefix with NEXT_PUBLIC_) ---------------------------
# The real backend. Only the Next.js server (src/app/api/[...path]/route.ts)
# reads this; the browser only ever talks to /api/* on this app's own origin.
CEDESK_API_URL=https://your-backend.example.com/api/v1

# --- Public, non-secret UI defaults -----------------------------------------
# Pre-fills the workspace field on the sign-in screen (optional).
NEXT_PUBLIC_DEFAULT_WORKSPACE=
# The backend's public address (same as CEDESK_API_URL). Only used to show the
# Admin the full webhook address in Settings > Cevanos (optional).
NEXT_PUBLIC_API_PUBLIC_URL=

# --- SERVER ONLY, optional ---------------------------------------------------
# Sign-in / password-reset attempts allowed per client per minute (default 10).
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Number of trusted reverse proxies / load balancers in front of this app that
# append to X-Forwarded-For (default 1). Set 0 if the app is exposed directly.
# Too high lets clients forge their IP and dodge the rate limit.
# TRUSTED_PROXY_HOPS=1
# For plain-HTTP test or staging servers only: set to 1 to drop the Secure cookie flag and the
# upgrade-insecure-requests CSP directive. Never set this in a real production deployment.
# ALLOW_INSECURE_HTTP=1
