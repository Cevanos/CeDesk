#!/usr/bin/env sh
# Enforce Conventional Commits: type(scope)!: summary
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
pattern='^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,100}$'
case "$first_line" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message must follow Conventional Commits, e.g. 'feat(tickets): add bulk resolve'."
  echo "Allowed types: feat fix perf refactor docs test build ci chore revert"
  exit 1
fi
