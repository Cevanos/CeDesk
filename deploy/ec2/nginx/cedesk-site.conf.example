# /etc/nginx/sites-available/cedesk  (then: ln -s into sites-enabled)
#
# Replace desk.example.com with the site's name. Install it as it is, HTTP only, then run
#   sudo certbot --nginx -d desk.example.com
# which adds the certificate and the HTTPS server block (copying everything below into it)
# and redirects port 80. The routing is deploy/Caddyfile's, for nginx.
#
# The upstreams cedesk_api and cedesk_web are not defined here: deploy/ec2/deploy.sh
# writes them to /etc/nginx/cevanos/cedesk-upstreams.conf, which nginx.conf includes at
# the http level (`include /etc/nginx/cevanos/*.conf;`), and rewrites them on every
# release to name the live slot. Never put a port number in this file.

server {
    listen 80;
    listen [::]:80;
    server_name desk.example.com;

    # Uploads and inbound email (CEDESK_INBOUND_EMAIL_MAX_BYTES is 30 MB).
    client_max_body_size 30m;

    # nginx is the one proxy in front of the app, so the address it saw is the client's.
    # Overwritten, never appended to: an X-Forwarded-For the client wrote is dropped.
    # (Behind Cloudflare or a load balancer, this is where its address range goes.)
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    # ── live updates (Server-Sent Events) ───────────────────────────────────
    # Open for hours and sent as they happen: no buffering, no compression. They end when
    # a release stops the old slot; the browser's EventSource reconnects to the new one.
    location = /api/v1/stream {
        proxy_pass http://cedesk_api;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }
    location = /api/v1/portal/stream {
        proxy_pass http://cedesk_api;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }
    # The same streams as the browser opens them, through the web app.
    location = /api/stream {
        proxy_pass http://cedesk_web;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }
    location = /api/portal/stream {
        proxy_pass http://cedesk_web;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }

    # ── the API: the web app's server, the mobile app, webhooks (Cevanos, inbound
    # email) and single sign-on. Its health checks and API docs too.
    location /api/v1/ {
        proxy_pass http://cedesk_api;
    }
    location = /readyz {
        proxy_pass http://cedesk_api;
    }
    location = /healthz {
        proxy_pass http://cedesk_api;
    }
    location = /docs {
        proxy_pass http://cedesk_api;
    }
    location /docs/ {
        proxy_pass http://cedesk_api;
    }
    location = /openapi.json {
        proxy_pass http://cedesk_api;
    }

    # ── the web app's own files ─────────────────────────────────────────────
    # Every release adds its /_next/static files to this one directory (deploy.sh), so a
    # page loaded before a release still finds its own build's chunks after it. Names are
    # content hashes: builds never overwrite each other. Anything not there yet (it is
    # copied before nginx is pointed at the new slot) falls through to the live slot.
    location ^~ /_next/static/ {
        root /var/www/cedesk;
        try_files $uri @web;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Everything else is the web app: pages, /api/* (its own routes, not /api/v1/).
    location / {
        proxy_pass http://cedesk_web;
    }

    location @web {
        proxy_pass http://cedesk_web;
    }
}
