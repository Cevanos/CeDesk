# The settings the running containers read. Copy to prod.env on your own machine, fill it
# in, and load it into Parameter Store (deploy/ec2/README.md, step 3):
#   uv run python deploy/ec2/env_ssm.py push --prefix /cevanos/prod/cedesk/ --env-file prod.env
# One parameter per line; an empty value is skipped. Never commit the filled-in file.
# Quote nothing and put no # comment after a value. A value cannot hold a quote or a
# newline (a JSON document on one line is fine). Generate secrets with: openssl rand -hex 32
#
# Only the names deploy/ec2/docker-compose.prod.yml lists reach a container. Everything
# else in deploy/env.example and docs/SETTINGS.md works the same way once it is added there.

# production, or staging for a shared test server.
CEDESK_ENV=production
# self_hosted: no plan limits. cloud: plan limits per workspace (`cedesk set-plan`).
CEDESK_EDITION=self_hosted

# The cedesk_app login (deploy/ec2/create-database.sh). 172.17.0.1 is the box from inside a
# container. The migration login is NOT here: see env.owner.example.
CEDESK_DATABASE_URL=postgresql+asyncpg://cedesk_app:REPLACE_WITH_APP_PASSWORD@172.17.0.1:5432/cedesk
CEDESK_SECRET_KEY=CHANGE_ME

# One address serves the web app and the API (/api/v1). The same https:// name in all four.
CEDESK_APP_URL=https://desk.example.com
CEDESK_API_URL=https://desk.example.com
CEDESK_CORS_ORIGINS=https://desk.example.com
# CEDESK_PORTAL_URL=

# Email out (the worker sends it) and the sender of password resets.
CEDESK_MAIL_BACKEND=smtp
CEDESK_MAIL_FROM_ADDRESS=no-reply@desk.example.com
CEDESK_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
CEDESK_SMTP_PORT=587
CEDESK_SMTP_SECURITY=starttls
CEDESK_SMTP_USERNAME=REPLACE
CEDESK_SMTP_PASSWORD=REPLACE

# Email in: a mailbox the worker reads, or a mail service posting to /api/v1/inbound/email
# with this token (32+ characters).
# CEDESK_IMAP_HOST=
# CEDESK_IMAP_USERNAME=
# CEDESK_IMAP_PASSWORD=
# CEDESK_INBOUND_EMAIL_TOKEN=

# Virus scan (the clamav container, about 1.5 GB). none: files are not checked.
CEDESK_SCAN_BACKEND=clamd

# Cevanos connector.
CEDESK_CEVANOS_URL=https://api.cevanos.ai
CEDESK_CEVANOS_APP_URL=https://cevanos.ai

# Uploaded files. local: the `files` volume on the box. s3: a bucket, read and written
# with the box's instance role (leave the keys out).
CEDESK_STORAGE_DRIVER=local
# CEDESK_STORAGE_DRIVER=s3
# CEDESK_STORAGE_S3_BUCKET=
# CEDESK_STORAGE_S3_REGION=us-east-1
