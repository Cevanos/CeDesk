# The migration login, alone, so only the one-off migrate container ever sees it. Load it
# under its own prefix (a sibling of the settings one, not inside it):
#   uv run python deploy/ec2/env_ssm.py push --prefix /cevanos/prod/cedesk-owner/ --env-file owner.env
# The deploy writes it to .env.migrate (mode 600) and reads it for `migrate` only.
CEDESK_MIGRATION_DATABASE_URL=postgresql+asyncpg://cedesk_owner:REPLACE_WITH_OWNER_PASSWORD@172.17.0.1:5432/cedesk
