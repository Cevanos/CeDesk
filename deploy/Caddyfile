# Custom help-center domains (feature-gap plan 4.2): OFF. To turn on, see "Custom
# help-center domains" in deploy/README.md: set CEDESK_TLS_ASK_KEY in deploy/.env, un-comment
# this block (Caddy only accepts a global options block as the FIRST block of the file, so it
# lives here) and the `https://` block at the bottom, and put the same key in place of <KEY>.
# {
# 	on_demand_tls {
# 		ask http://api:8100/api/v1/internal/tls-ask?key=<KEY>
# 	}
# }

# CEDESK_SITE is a domain (desk.example.com: Caddy gets an HTTPS certificate by itself)
# or :80 (plain HTTP on the server's IP, for a short test only).
{$CEDESK_SITE} {
	request_body {
		max_size 30MB
	}

	# Live updates (Server-Sent Events) stay open for a long time and are sent as they happen:
	# not compressed (gzip would hold the frames back) and not buffered.
	@live path /api/v1/stream /api/v1/portal/stream
	handle @live {
		reverse_proxy api:8100 {
			flush_interval -1
		}
	}
	# The same streams as the browser opens them, through the web app.
	@weblive path /api/stream /api/portal/stream
	handle @weblive {
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}

	# AI apps (the MCP connector): the MCP endpoint, where they sign in, and the discovery
	# documents. Before the web app's catch-all, which would answer them otherwise (the web
	# app keeps the rest of /.well-known, e.g. security.txt). /mcp is not buffered (a tool
	# call may stream its answer).
	@mcp path /mcp
	handle @mcp {
		reverse_proxy api:8100 {
			flush_interval -1
		}
	}
	@oauth path /oauth/* /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource* /.well-known/openai-apps-challenge
	handle @oauth {
		reverse_proxy api:8100
	}

	# The API: the web app's server, the mobile app, webhooks (Cevanos, inbound email) and
	# single sign-on. Its health checks and API docs (/docs) too.
	@api path /api/v1/* /readyz /healthz /docs /docs/* /openapi.json
	handle @api {
		encode gzip
		reverse_proxy api:8100
	}

	# Everything else is the web app.
	handle {
		encode gzip
		reverse_proxy web:3000
	}
}

# Optional: a host of its own for AI apps, e.g. mcp.cedesk.in on CeDesk Cloud. Point its DNS
# at this server, set CEDESK_MCP_SITE to it, set CEDESK_OAUTH_ISSUER=https://<that host>
# for the api, and uncomment. It serves only the AI-app paths; members still sign in and
# approve on the web app's own address (CEDESK_SITE).
#
