# Copy to deploy/backup.env (chmod 600) on the server. backup.sh reads it; cron does not
# load deploy/.env. Nothing here is a secret: the private key never comes to the server.

# The fingerprint of the PUBLIC key backups are encrypted for. Make the key pair on a
# laptop or a password manager, not on this server:
#   gpg --quick-gen-key "CeDesk backups" rsa4096 encrypt never
#   gpg --export --armor <fingerprint> > cedesk-backup.pub    # copy this to the server
#   gpg --import cedesk-backup.pub                            # on the server, as root
# Keep the private key (gpg --export-secret-keys) offline, in two places.
BACKUP_GPG_RECIPIENT=

BACKUP_DIR=/root/cedesk-backups
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7
BACKUP_FILES=1
# On a server started with an extra compose file:
# BACKUP_COMPOSE="docker compose -f docker-compose.yml -f docker-compose.shared.yml"
# BACKUP_ALERT_URL=https://hooks.slack.com/services/...
