# Copy to deploy/.env (never commit it) and fill in. Make each secret with:
#   openssl rand -hex 32
# (hex only, so the passwords are safe inside database URLs)

POSTGRES_PASSWORD=
CEDESK_OWNER_PASSWORD=
CEDESK_APP_PASSWORD=
CEDESK_SECRET_KEY=

# staging for a shared test server, production for real customers.
CEDESK_ENV=staging

# The domain pointing at this server (gets HTTPS), or :80 to use the IP over plain HTTP.
CEDESK_SITE=:80

# Sites whose pages call the API from a browser, comma-separated.
CEDESK_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# The agent app's address: links in emails (password reset) point here.
CEDESK_APP_URL=http://localhost:3000
# Sender of password-reset emails when a workspace has no support address yet.
CEDESK_MAIL_FROM_ADDRESS=

# Email (the `worker` service sends it). `log`: written to the worker's log, nothing sent
# (fine for a test server; refused in production). `smtp`: any SMTP server, e.g. Amazon
# SES (email-smtp.<region>.amazonaws.com), Gmail or Zoho with an app password.
CEDESK_MAIL_BACKEND=log
CEDESK_SMTP_HOST=
CEDESK_SMTP_PORT=587
CEDESK_SMTP_SECURITY=starttls
CEDESK_SMTP_USERNAME=
CEDESK_SMTP_PASSWORD=

# Email in: choose one (or both).
# a) A mailbox the worker reads every few seconds (Gmail / Zoho with an app password).
#    Customers write to the support address; it lands in this mailbox.
CEDESK_IMAP_HOST=
CEDESK_IMAP_PORT=993
CEDESK_IMAP_USERNAME=
CEDESK_IMAP_PASSWORD=
CEDESK_IMAP_FOLDER=INBOX

# Virus scan (ClamAV). none: files are not checked. clamd: start the scanner with
# `docker compose --profile scan up -d`; files can be downloaded and emailed only once
# found clean, and infected ones are removed.
CEDESK_SCAN_BACKEND=none
# Keep equal to clamd's StreamMaxLength (100M by default). Bigger files are marked
# "could not be checked" (blocked) without being sent to ClamAV.
# CEDESK_CLAMD_MAX_BYTES=104857600
# b) A mail service (Mailgun, SendGrid, ...) posts each email to
#    https://<server>/api/v1/inbound/email with this token. Random, 32+ characters.
CEDESK_INBOUND_EMAIL_TOKEN=
