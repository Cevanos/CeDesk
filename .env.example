# Copy to .env for local development. These match docker-compose.yml and are for development only.
CEDESK_DATABASE_URL=postgresql+asyncpg://cedesk_app:cedesk_app_dev@localhost:5447/cedesk
CEDESK_MIGRATION_DATABASE_URL=postgresql+asyncpg://cedesk_owner:cedesk_owner_dev@localhost:5447/cedesk
CEDESK_EDITION=cloud
CEDESK_SECRET_KEY=dev-only-change-me

# Uploaded files: `local` (a folder, ignored by git), `s3` (AWS, MinIO, R2, ...), `gcs` or
# `azure` (see README, Files).
CEDESK_STORAGE_DRIVER=local
CEDESK_STORAGE_LOCAL_PATH=storage
# For a local MinIO instead (shown with MinIO's default login):
# CEDESK_STORAGE_DRIVER=s3
# CEDESK_STORAGE_S3_BUCKET=cedesk-files
# CEDESK_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
# CEDESK_STORAGE_S3_PATH_STYLE=true
# CEDESK_STORAGE_S3_ACCESS_KEY_ID=minioadmin
# CEDESK_STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
